	quest.8020539A1BF033B0.quest_desc: [
		"≤5 jugadores. No grief. Claims FTB Chunks. Pregunta antes de builds enormes junto a bases ajenas."
		"Lag: evita farms idiotas; Create/Mek a escala razonable."
	]
