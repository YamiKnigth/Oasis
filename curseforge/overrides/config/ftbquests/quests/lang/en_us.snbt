	quest.4811876854A83DAB.quest_subtitle: "Aleaciones y alimentos"
	quest.4811876854A83DAB.quest_desc: [
		"Gira sobre un basin. Brass, dough y Create Food pasan por aqui."
		"Algunas recetas piden Blaze Burner heated/superheated debajo."
	]
	quest.7AE3B8DEB273D0B7.title: "Encased Fan"
	quest.7AE3B8DEB273D0B7.quest_subtitle: "Lavado, ahumado, haunting..."
	quest.7AE3B8DEB273D0B7.quest_desc: ["Sopla a traves de lava/agua/soul fire para procesar items en el aire o cintas."]
	quest.3C4463E7D6BE2A2B.title: "Nozzle"
