	quest.3BC29A8A7B03A220.title: "Crushing Wheels"
	quest.3BC29A8A7B03A220.quest_subtitle: "Triturado avanzado"
	quest.3BC29A8A7B03A220.quest_desc: ["Dos ruedas enfrentadas. Mejor yield de ores que el millstone. Cuidado con el SU."]
	quest.7E9AA9519E5E4BBC.title: "Mechanical Saw"
	quest.7E9AA9519E5E4BBC.quest_subtitle: "Tala y cortado"
	quest.7E9AA9519E5E4BBC.quest_desc: ["Corta troncos/paneles y arma tree farms en contraptions."]
	quest.BCCCAF428315E492.title: "Mechanical Drill"
	quest.BCCCAF428315E492.quest_subtitle: "Mineria movil"
	quest.BCCCAF428315E492.quest_desc: ["Taladra bloques frente a ella. Base de quarry-contraptions."]
	quest.297FAE687FBF5A39.title: "Mechanical Plough"
	quest.297FAE687FBF5A39.quest_subtitle: "Labra / clear path"
	quest.297FAE687FBF5A39.quest_desc: ["En contraptions allana tierra/nieve y prepara campos."]
