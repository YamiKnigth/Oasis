	quest.B7ABB8CFB38CB940.quest_subtitle: "Donde mirar"
	quest.B7ABB8CFB38CB940.quest_desc: ["JEI = recetas reales del pack. Docs: TECH_PROGRESSION.md, QUESTS.md, INSTALL.md."]
	quest.20AF13BAD9B1D7E1.title: "Listo para Oasis"
	quest.20AF13BAD9B1D7E1.quest_subtitle: "Elige tu arco"
	quest.20AF13BAD9B1D7E1.quest_desc: [
		"Tienes comida, tech, magia y exploracion senaladas."
		"No hay orden unico: cozy first esta permitido. Cuando quieras poder industrial, sigue Create."
		"&6Oasis:&r Buena suerte y que la parrilla te acompane."
	]
	chapter.1BA0E6793148BB97.title: "&6&lCocina y BBQ"
	quest.F5B56C370F94D4B8.title: "Cocina y BBQ"
	quest.F5B56C370F94D4B8.quest_subtitle: "El corazon cozy de Oasis"
	quest.F5B56C370F94D4B8.quest_desc: [
		"Comer bien es tan valido como fabricar. Esta guia cubre Farmer Delight, la parrilla, fermentos, addons y el puente a Create."
		"&6Oasis:&r Polymorph ayuda si ves recetas de comida conflictivas en JEI. Slice and Dice / Create Food conectan con el capitulo Create."
	]
