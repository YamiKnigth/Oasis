	quest.50EF97C44B9CB5D5.quest_subtitle: "Mas SU"
	quest.50EF97C44B9CB5D5.quest_desc: ["Mayor capacidad de estres cuando ya tienes varias maquinas andesite."]
	quest.3E5CC762F417085C.title: "Windmill Bearing"
	quest.3E5CC762F417085C.quest_subtitle: "Velas = poder pasivo"
	quest.3E5CC762F417085C.quest_desc: [
		"Construye un rotor de wool/velas. Mas velas = mas capacidad."
		"Excelente poder pasivo mid-game antes del vapor."
	]
	quest.6DC76306EE09FB07.title: "Empty Blaze Burner"
	quest.6DC76306EE09FB07.quest_subtitle: "Base del vapor"
	quest.6DC76306EE09FB07.quest_desc: ["Se convierte en Blaze Burner capturando un blaze."]
	quest.61C2AB466D3C4776.title: "Blaze Burner"
	quest.61C2AB466D3C4776.quest_subtitle: "Calor para vapor y cocina"
	quest.61C2AB466D3C4776.quest_desc: ["Alimentalo con fuel. Superheated (blaze cake) desbloquea recetas avanzadas del mixer."]
	quest.2D882DE63B6DD848.title: "Steam Engine"
	quest.2D882DE63B6DD848.quest_subtitle: "Poder mid/late Create"
	quest.2D882DE63B6DD848.quest_desc: ["Motor de vapor con Blaze Burner + agua. Gran salto de SU para brass y trenes."]
	quest.7F13F6098A0A05F7.title: "Flywheel"
	quest.7F13F6098A0A05F7.quest_subtitle: "Inercia / buffer"
	quest.7F13F6098A0A05F7.quest_desc: ["Acompana al steam engine y estabiliza la linea."]
	quest.544BD0259881FBD7.title: "Procesado andesite"
	quest.544BD0259881FBD7.quest_subtitle: "Moler, prensar, mezclar, triturar"
	quest.544BD0259881FBD7.quest_desc: ["Estas maquinas definen el early Create: harina, placas, aleaciones y crushed ores."]
	quest.DE447BEDCA827349.title: "Millstone"
	quest.DE447BEDCA827349.quest_subtitle: "Muele items"
	quest.DE447BEDCA827349.quest_desc: ["Muele wheat, ores early y varios materiales. Entrada superior / depot."]
