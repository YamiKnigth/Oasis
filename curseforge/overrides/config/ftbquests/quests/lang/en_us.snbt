	quest.824FF2403218E580.quest_subtitle: "Cosecha automatica"
	quest.824FF2403218E580.quest_desc: ["Cosecha cultivos frente a la contraption."]
	quest.C32F0C43C841C8D4.title: "Logistica de items"
	quest.C32F0C43C841C8D4.quest_subtitle: "Cintas, funnels, vaults"
	quest.C32F0C43C841C8D4.quest_desc: ["Mover items sin hoppers vanilla es el alma de Create."]
