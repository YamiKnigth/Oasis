		"Cada maquina consume Stress Units (SU); planifica la red."
	]
	quest.C6DF6027258A7B5D.title: "Engranajes"
	quest.C6DF6027258A7B5D.quest_subtitle: "Relacion 1:1 lateral"
	quest.C6DF6027258A7B5D.quest_desc: ["Mueven la rotacion en L y cambian eje. Combinalos con large cogwheels para ratios."]
	quest.D17DE7016BFC5C74.title: "Engranaje grande"
	quest.D17DE7016BFC5C74.quest_subtitle: "Cambia velocidad"
	quest.D17DE7016BFC5C74.quest_desc: ["Par large+small cambia RPM. Mas velocidad suele ser mas SU."]
	quest.08F565E4FD380F9B.title: "Andesite Casing"
	quest.08F565E4FD380F9B.quest_subtitle: "Chasis madera + aleacion"
	quest.08F565E4FD380F9B.quest_desc: ["Base de funnels, gearboxes y muchas maquinas andesite."]
	quest.9B702464C2B879ED.title: "Gearbox"
	quest.9B702464C2B879ED.quest_subtitle: "Gira la rotacion 90 grados"
	quest.9B702464C2B879ED.quest_desc: ["Encaja ejes en distintas caras. Esencial para layouts compactos."]
	quest.18D5041FEEB3C177.title: "Clutch"
	quest.18D5041FEEB3C177.quest_subtitle: "Corte con redstone"
	quest.18D5041FEEB3C177.quest_desc: ["Con senal redstone desconecta la transmision. Pausa lineas sin romper ejes."]
	quest.8014FEE85D5A4515.title: "Gearshift"
	quest.8014FEE85D5A4515.quest_subtitle: "Invierte sentido"
	quest.8014FEE85D5A4515.quest_desc: ["Invierte la rotacion con redstone. Util en crushers dobles y sync."]
	quest.6A4D35C3A3E86228.title: "Energia cinetica"
	quest.6A4D35C3A3E86228.quest_subtitle: "Seccion: fuentes de RPM"
	quest.6A4D35C3A3E86228.quest_desc: ["Create usa rotacion, no FE en el core. Empieza simple y escala a windmill/steam."]
	quest.FD9468CE06C5BBD1.title: "Hand Crank"
	quest.FD9468CE06C5BBD1.quest_subtitle: "Pruebas a mano"
	quest.FD9468CE06C5BBD1.quest_desc: ["Gira a mano para testear. No es base industrial, pero ensena el flujo."]
	quest.9AAC9EF2D8A5544E.title: "Water Wheel"
	quest.9AAC9EF2D8A5544E.quest_subtitle: "Poder early estable"
	quest.9AAC9EF2D8A5544E.quest_desc: ["Colocala con flujo de agua real. Buen primer motor para millstone/press."]
